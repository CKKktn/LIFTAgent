# Run locally first. The first visit lets you create the administrator account.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=.local-data
APP_SECURE_COOKIE=false
APP_ENABLE_TRACING=false

# Optional server bootstrap. For normal local use leave these blank and create
# your own account on the first login page. Never use the old website password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: configure a real OpenAI-compatible endpoint now or in Model Settings.
# Examples: https://api.deepseek.com/v1 , http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional remote embeddings. Without this the app uses local feature vectors
# and lexical matching, which do not require a model download or API key.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional parsing of legacy .doc/.xls/.ppt formats. Browser Office previews
# are reflowed text previews, not a reproduction of the original layout.
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
MAX_UPLOAD_MB=64

